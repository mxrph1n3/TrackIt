# Supabase (required for auth + leaderboard)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for `npm run seed` (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deep linking — add these exact redirect URLs in Supabase Dashboard:
# Authentication → URL Configuration
#   Site URL: https://track-it-umber-psi.vercel.app  (NOT http://localhost:3000)
# Redirect URLs:
#   trackit2://auth/callback
#   https://track-it-umber-psi.vercel.app/auth/callback
#
# Native subscriptions (App Store Connect + Google Play Console — no RevenueCat):
#   trackit_pro_monthly_v2  — $5.99/month
#   trackit_pro_yearly_v2   — $50.00/year
#
# Create auto-renewable subscriptions with those exact product IDs in both stores,
# then ship an app update. Users pay only through Apple / Google.
#
# Server-side (Supabase Edge Functions secrets — never in the mobile client):
# SUPABASE_SERVICE_ROLE_KEY=...
# GEMINI_API_KEY=...
# ALLOWED_ORIGIN=https://your-domain.com
#
# EXPO_PUBLIC_WEB_APP_URL=https://your-tma-domain.com
#
# Telegram Mini App (Stars monthly subscription + 3-day trial)
# EXPO_PUBLIC_TMA_STARS_PRICE=300
#
# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets):
# TELEGRAM_BOT_TOKEN=...
# TMA_AUTH_SECRET=... (optional; defaults to TELEGRAM_BOT_TOKEN)
# TMA_STARS_PRICE=300
# TMA_MONTHLY_PRICE_LABEL=$5.99/month
# TMA_WEB_APP_URL=https://your-tma-domain.com
# ALLOWED_ORIGIN=https://your-tma-domain.com
#
# Configure bot commands, menu button, and webhook:
# TELEGRAM_BOT_TOKEN=... TMA_WEB_APP_URL=... node scripts/setup-telegram-bot.mjs
#
# Set Telegram webhook to: https://<project-ref>.supabase.co/functions/v1/telegram-webhook
